# Required: Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Path to your resume PDF (default: ./resume.pdf)
RESUME_PATH=./resume.pdf

# Target job application URL
JOB_URL=https://ats.rippling.com/en-CA/opendoor/jobs/f572e889-0644-4590-8a5a-64f73d7db17d/apply?step=application

# Model for the ADK chat layer (default: gemini-flash-lite-latest)
ADK_MODEL=gemini-flash-lite-latest

# Model for the Stagehand browser agent (default: google/gemini-flash-lite-latest)
STAGEHAND_MODEL=google/gemini-flash-lite-latest
